# airflow_settings.yaml.example
# Copie este arquivo para airflow_settings.yaml e preencha com as credenciais reais.
# ATENÇÃO: Nunca comite o arquivo airflow_settings.yaml real!

# This file allows you to configure Airflow Connections, Pools, and Variables in a single place for local development only.
# NOTE: json dicts can be added to the conn_extra field as yaml key value pairs. See the example below.

airflow:
  connections:
    - conn_id: ecommerce_warehouse
      conn_type: postgres
      conn_host: host.docker.internal
      conn_schema: ecommerce
      conn_login: ecommerce
      conn_password: "pass123"
      conn_port: 5433
      conn_extra:
  pools:
    - pool_name:
      pool_slot:
      pool_description:
  variables:
    # Controla qual volume de dados as 4 DAGs de benchmark carregam.
    # "small" (default se a Variable nao existir) -> dbt seed, comportamento
    # original. "large" -> ~10.000.000 linhas geradas via Faker, carregadas
    # direto no schema raw (ver include/ingestion/airflow_tasks.py).
    - variable_name: ecommerce_dataset_size
      variable_value: small
    # Quantidade de linhas de raw_orders geradas quando dataset_size="large".
    - variable_name: ecommerce_large_dataset_n_orders
      variable_value: "10000000"
    # Warehouses loaded by ecommerce_ingestion_dag. Use "duckdb", "postgres",
    # or "duckdb,postgres" depending on which benchmark targets are available.
    - variable_name: ecommerce_ingestion_warehouses
      variable_value: duckdb,postgres
